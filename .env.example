# Database. On Vercel this is created for you by Storage > Neon Postgres.
DATABASE_URL=

# Any long random string. Sessions are signed with it, so keep it secret
# and do not change it after go live or everyone is logged out.
PAYLOAD_SECRET=

# The address the site is served from, with no trailing slash.
# Staging: the cms preview address, then https://toothncaresep10.vercel.app
# Live:    https://toothncare.com.au
NEXT_PUBLIC_SERVER_URL=

# Media storage. Vercel > Storage > Blob creates this for you.
BLOB_READ_WRITE_TOKEN=

# Vercel > Settings > Git > Deploy Hooks. The Publish website button calls it.
PUBLISH_HOOK_URL=

# Enquiry email, from SMTP2GO
SMTP2GO_API_KEY=
MAIL_FROM=website@toothncare.com.au
MAIL_TO=reception@toothncare.com.au,SMILEOX-INTAKE@toothncare.com.au,rowayne@gyaclients.com
