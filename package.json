    "dotenv": "^18.0.4",
    "graphql": "^16.8.1",
    "next": "16.4.4",
    "payload": "3.92.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
